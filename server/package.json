{
  "name": "crashbeds-server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "migrate": "node-pg-migrate -j sql",
    "migrate:create": "node-pg-migrate create -j sql",
    "db:check": "tsx src/check-db.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "node-pg-migrate": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "pg": "^8.23.1"
  }
  
}
